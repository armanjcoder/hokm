PORT=4000
DB_PATH=./data/hokm.sqlite

# اگر کل پروژه را از همان بک‌اند سرو می‌کنید، true باشد.
SERVE_WEB_DIST=true

# در حالت یک‌تونله، هر دو مقدار زیر همان آدرس Cloudflare Tunnel هستند.
# مثال: https://random-name.trycloudflare.com
WEB_APP_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000

# همان آدرس WEB_APP_URL. برای تست محلی می‌توانید http://localhost:4000 هم بگذارید.
CORS_ORIGIN=http://localhost:4000

# توکن را فقط در فایل .env واقعی بگذارید. هرگز commit نکنید.
TELEGRAM_BOT_TOKEN=

# فقط برای توسعه در مرورگر بدون تلگرام.
# اگر true باشد، امضای initData بررسی نمی‌شود و همه به عنوان «مهمان» وارد می‌شوند.
# در استفاده واقعی حتماً false بماند یا اصلاً تنظیم نشود.
ALLOW_UNVERIFIED_TELEGRAM=false
