PORT=4000
DB_PATH=./data/hokm.sqlite

# اگر کل پروژه را از همان بک‌اند سرو می‌کنید، true باشد.
SERVE_WEB_DIST=true

# در حالت یک‌تونله، هر دو مقدار زیر همان آدرس Cloudflare Tunnel هستند.
# مثال: https://random-name.trycloudflare.com
WEB_APP_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000

# همان آدرس WEB_APP_URL. برای تست محلی می‌توانید http://localhost:4000 هم بگذارید.
CORS_ORIGIN=http://localhost:4000

# توکن را فقط در فایل .env واقعی بگذارید. هرگز commit نکنید.
TELEGRAM_BOT_TOKEN=

# اگر api.telegram.org از شبکه شما در دسترس نیست (مثلاً فیلتر است) اما بقیه
# اینترنت کار می‌کند، فقط ترافیک ربات را از یک پروکسی عبور دهید. با این کار
# لازم نیست VPN سیستمی روشن کنید (که تونل Cloudflare را قطع می‌کند).
# نمونه‌ها:
#   TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
#   TELEGRAM_PROXY_URL=http://127.0.0.1:8080
#   TELEGRAM_PROXY_URL=socks5://user:pass@127.0.0.1:1080
TELEGRAM_PROXY_URL=

# فقط برای توسعه در مرورگر بدون تلگرام.
# اگر true باشد، امضای initData بررسی نمی‌شود و همه به عنوان «مهمان» وارد می‌شوند.
# در استفاده واقعی حتماً false بماند یا اصلاً تنظیم نشود.
ALLOW_UNVERIFIED_TELEGRAM=false

# چرخه عمر میزها (ساعت). خالی بگذارید تا مقادیر پیش‌فرض استفاده شود.
ROOM_LOBBY_TTL_HOURS=6
ROOM_PLAYING_TTL_HOURS=12
ROOM_FINISHED_TTL_HOURS=24
ROOM_CLEANUP_INTERVAL_HOURS=1

# محافظت در برابر سوءاستفاده
RATE_LIMIT_CREATE_PER_MIN=6
RATE_LIMIT_ACTIONS_PER_MIN=60
MAX_ROOMS=500
